<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CapChief.Platform\CapChief.Platform.csproj" />
    <Compile Include="..\CapChief\**\*.cs" Exclude="..\CapChief\Program.cs;..\CapChief\obj\**;..\CapChief\bin\**" LinkBase="App" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>CapChief.Tests</AssemblyName>
    <RootNamespace>CapChief.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
